 "passwordCmdPresets": [
  {
   "name": "macOS Keychain",
   "command": "security find-generic-password -s webtuidb -a <name> -w",
   "note": "add it with: security add-generic-password -s webtuidb -a <name> -w"
  },
  {
   "name": "Linux secret-tool",
   "command": "secret-tool lookup service webtuidb account <name>",
   "note": "add it with: secret-tool store --label=webtuidb service webtuidb account <name>"
  },
  {
   "name": "pass",
   "command": "pass show webtuidb/<name>",
   "note": "add it with: pass insert webtuidb/<name>"
  },
  {
   "name": "1Password",
   "command": "op read \"op://Private/<name>/password\"",
   "note": "needs the op CLI signed in"
  }
 ],
